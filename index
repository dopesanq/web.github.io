<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nattakorn Chukumnird</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=DM+Serif+Display:ital@0;1&family=Sarabun:wght@300;400;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink: #0d0d0d;
    --paper: #f5f0e8;
    --accent: #c8452a;
    --accent2: #1a4a8a;
    --muted: #7a7060;
    --border: #d4c9b0;
    --mono: 'Space Mono', monospace;
    --serif: 'DM Serif Display', serif;
    --thai: 'Sarabun', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--mono);
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ── BILINGUAL ── */
  .lang-th { display: none; }
  html.lang-thai .lang-en { display: none; }
  html.lang-thai .lang-th { display: inline; }
  html.lang-thai .lang-th-block { display: block; }
  html.lang-thai .lang-en-block { display: none; }

  html.lang-thai body { font-family: var(--thai); }
  html.lang-thai h1,
  html.lang-thai h2 { font-family: var(--thai); font-weight: 700; letter-spacing: 0; }
  html.lang-thai .about-text p,
  html.lang-thai .hero-desc,
  html.lang-thai .cv-item-desc,
  html.lang-thai .cv-item-sub,
  html.lang-thai .proj-desc,
  html.lang-thai .contact-intro { font-family: var(--thai); font-size: 15px; }
  html.lang-thai .skill-list li,
  html.lang-thai .nav-links a,
  html.lang-thai .cv-section-title,
  html.lang-thai .cv-item-title,
  html.lang-thai .stat-label,
  html.lang-thai .hero-tag,
  html.lang-thai .form-label,
  html.lang-thai .award-list li,
  html.lang-thai footer { font-family: var(--thai); letter-spacing: 0.02em; }

  /* marquee separate elements per language */
  .marquee-inner.lang-th { display: none; }
  html.lang-thai .marquee-inner.lang-en { display: none; }
  html.lang-thai .marquee-inner.lang-th { display: inline-block; font-family: var(--thai); }

  /* lang toggle button */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border: 1.5px solid var(--ink);
    background: transparent;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .lang-toggle:hover { background: var(--ink); color: var(--paper); }
  html.lang-thai .lang-toggle { font-family: var(--thai); letter-spacing: 0.02em; }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2.5rem;
    background: var(--paper);
    border-bottom: 1.5px solid var(--ink);
  }
  .nav-logo {
    font-family: var(--serif);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-right { display: flex; align-items: center; gap: 2rem; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--accent); }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    padding: 8rem 2.5rem 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: end;
    border-bottom: 1.5px solid var(--ink);
    position: relative;
    overflow: hidden;
  }
  .hero-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--serif);
    font-size: clamp(120px, 18vw, 260px);
    color: transparent;
    -webkit-text-stroke: 1px rgba(13,13,13,0.07);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }
  .hero-left { position: relative; z-index: 1; }
  .hero-tag {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 3px 10px;
    margin-bottom: 1.5rem;
  }
  html.lang-thai .hero-tag { font-family: var(--thai); letter-spacing: 0.04em; text-transform: none; }
  h1 {
    font-family: var(--serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: var(--ink);
  }
  h1 em { font-style: italic; color: var(--accent); }
  .hero-desc {
    max-width: 420px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }
  .btn-group { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 10px 24px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  html.lang-thai .btn { font-family: var(--thai); letter-spacing: 0.04em; }
  .btn-primary { background: var(--ink); color: var(--paper); }
  .btn-primary:hover { background: var(--accent); }
  .btn-outline { background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
  .btn-outline:hover { background: var(--ink); color: var(--paper); }
  .hero-right {
    position: relative;
    z-index: 1;
    align-self: end;
    padding-bottom: 2rem;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5px;
    border: 1.5px solid var(--border);
  }
  .stat-cell { padding: 1.5rem 1.25rem; background: var(--paper); }
  .stat-cell:nth-child(odd) { border-right: 1.5px solid var(--border); }
  .stat-cell:nth-child(1), .stat-cell:nth-child(2) { border-bottom: 1.5px solid var(--border); }
  .stat-num {
    font-family: var(--serif);
    font-size: 2.8rem;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat-num span { color: var(--accent); font-size: 0.6em; vertical-align: super; }
  .stat-num.emoji { font-size: 2.2rem; }
  .stat-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── ABOUT ── */
  #about {
    display: grid;
    grid-template-columns: 1fr 2fr;
    border-bottom: 1.5px solid var(--ink);
  }
  .section-label {
    padding: 3rem 2.5rem;
    border-right: 1.5px solid var(--ink);
    display: flex;
    align-items: flex-start;
  }
  .section-label span {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  html.lang-thai .section-label span { font-family: var(--thai); letter-spacing: 0.06em; }
  .section-content { padding: 3rem; }
  h2 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--ink);
  }
  h2 em { color: var(--accent2); font-style: italic; }
  .about-body {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .about-text p {
    color: var(--muted);
    margin-bottom: 1rem;
    font-size: 13px;
    line-height: 1.9;
  }
  .skill-list { list-style: none; }
  .skill-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
  }
  .skill-list li::before { content: '→'; color: var(--accent); font-size: 11px; flex-shrink: 0; }

  /* ── PROJECTS ── */
  #projects {
    display: grid;
    grid-template-columns: 1fr 2fr;
    border-bottom: 1.5px solid var(--ink);
  }
  .proj-container { padding: 3rem; }
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1.5px solid var(--border);
    margin-top: 1.5rem;
    grid-column: 1 / -1;
    margin-left: calc(2.5rem + 1.5px);
  }
  .project-card {
    padding: 1.75rem 1.5rem;
    border-bottom: 1.5px solid var(--border);
    border-right: 1.5px solid var(--border);
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }
  .project-card:nth-child(even) { border-right: none; }
  .project-card:last-child { border-bottom: none; }
  .project-card:nth-last-child(2):nth-child(odd) { border-bottom: none; }
  .project-card:hover { background: rgba(200,69,42,0.04); }
  .project-card:hover .proj-arrow { transform: translate(4px, -4px); }
  .proj-num {
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .proj-title {
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  html.lang-thai .proj-title { font-family: var(--thai); font-weight: 700; }
  .proj-subtitle {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 0.75rem;
    font-style: italic;
    line-height: 1.4;
  }
  .proj-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .proj-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1.5rem; }
  .proj-tag {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 8px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .proj-arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    font-size: 1.2rem;
    color: var(--accent);
    transition: transform 0.2s;
  }

  /* ── CV ── */
  #cv {
    display: grid;
    grid-template-columns: 1fr 2fr;
    border-bottom: 1.5px solid var(--ink);
  }
  .cv-content { padding: 3rem; }
  .cv-section { margin-bottom: 2.5rem; }
  .cv-section-title {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  html.lang-thai .cv-section-title { text-transform: none; letter-spacing: 0.04em; }
  .cv-item { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .cv-item:last-child { border-bottom: none; }
  .cv-item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; gap: 1rem; }
  .cv-item-title { font-weight: 700; font-size: 13px; color: var(--ink); }
  .cv-item-year { font-size: 11px; color: var(--accent); white-space: nowrap; flex-shrink: 0; }
  .cv-item-sub { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
  .cv-item-desc { font-size: 12px; color: var(--muted); line-height: 1.7; }

  /* achievements list */
  .award-list { list-style: none; padding: 0; }
  .award-list li {
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .award-list li:last-child { border-bottom: none; }
  .award-list .award-icon { flex-shrink: 0; font-size: 13px; }

  .cv-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border: 1.5px solid var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    margin-top: 1.5rem;
    transition: all 0.2s;
    cursor: pointer;
    background: transparent;
  }
  html.lang-thai .cv-download { font-family: var(--thai); letter-spacing: 0.04em; text-transform: none; }
  .cv-download:hover { background: var(--ink); color: var(--paper); }

  /* ── CONTACT ── */
  #contact { display: grid; grid-template-columns: 1fr 2fr; }
  .contact-content { padding: 3rem; }
  .contact-intro { color: var(--muted); font-size: 13px; line-height: 1.9; margin-bottom: 2rem; max-width: 400px; }
  .contact-links { display: flex; flex-direction: column; gap: 0; margin-bottom: 2.5rem; }
  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    font-size: 13px;
    transition: color 0.2s;
  }
  .contact-link:hover { color: var(--accent); }
  .contact-link .link-label { color: var(--muted); font-size: 11px; }
  html.lang-thai .contact-link .link-label { font-family: var(--thai); }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 4px; }
  .form-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  html.lang-thai .form-label { text-transform: none; letter-spacing: 0.04em; }
  .form-input, .form-textarea {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--border);
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.2s;
    resize: none;
  }
  html.lang-thai .form-input,
  html.lang-thai .form-textarea { font-family: var(--thai); }
  .form-input:focus, .form-textarea:focus { border-color: var(--ink); }
  .form-textarea { height: 100px; }

  /* ── FOOTER ── */
  footer {
    padding: 1.5rem 2.5rem;
    border-top: 1.5px solid var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  /* ── MARQUEE ── */
  .marquee-strip {
    overflow: hidden;
    border-bottom: 1.5px solid var(--ink);
    border-top: 1.5px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    padding: 10px 0;
    white-space: nowrap;
  }
  .marquee-inner {
    display: inline-block;
    animation: marquee 22s linear infinite;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 700px) {
    #hero { grid-template-columns: 1fr; }
    #about, #projects, #cv, #contact { grid-template-columns: 1fr; }
    .section-label { display: none; }
    .project-grid { margin-left: 0; grid-template-columns: 1fr; }
    .project-card:nth-child(even) { border-right: none; }
    .about-body { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    nav { padding: 1rem 1.25rem; }
    .nav-links { gap: 1rem; }
    .nav-right { gap: 1rem; }
  }
</style>
</head>
